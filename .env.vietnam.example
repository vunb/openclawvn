# ============================================================
# OpenClaw Vietnam Edition — Environment Variables (Docker)
# ============================================================
# Sao chép file này sang .env và điền thông tin thực của bạn:
#   cp .env.vietnam.example .env
# QUAN TRỌNG: Không bao giờ commit file .env lên version control!
# ============================================================

# ── Docker Image ─────────────────────────────────────────────
# Tên image Docker; dùng "openclaw:local" khi build local,
# hoặc tên registry nếu pull từ xa.
OPENCLAW_IMAGE=openclaw:local

# ── Gateway Network ──────────────────────────────────────────
# Bind address trong container:
#   loopback  → chỉ localhost (phát triển)
#   lan       → mạng nội bộ (LAN + Docker bridge)
#   0.0.0.0   → tất cả interface (cẩn thận khi public)
OPENCLAW_GATEWAY_BIND=lan

# Cổng gateway được map ra host
OPENCLAW_GATEWAY_PORT=18789

# Cổng bridge (kết nối mobile app / CLI ngoài container)
OPENCLAW_BRIDGE_PORT=18790

# ── Auth Token ───────────────────────────────────────────────
# Token xác thực gateway — sinh ngẫu nhiên bằng:
#   openssl rand -hex 32
# docker-setup.sh tự sinh nếu để trống.
OPENCLAW_GATEWAY_TOKEN=

# ── Volume / Data Dirs ───────────────────────────────────────
# Thư mục config của OpenClaw trên HOST (mounted vào container)
OPENCLAW_CONFIG_DIR=~/.openclaw

# Thư mục workspace (skills, session data, v.v.)
OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# (Tuỳ chọn) Docker named volume cho /home/node bên trong container
# Để trống để dùng bind-mount mặc định
OPENCLAW_HOME_VOLUME=

# (Tuỳ chọn) Thêm mount tuỳ chọn, phân cách bằng dấu phẩy
# Ví dụ: /host/path:/container/path,/another:/mount
OPENCLAW_EXTRA_MOUNTS=

# (Tuỳ chọn) Các apt package bổ sung cần cài trong image
# Ví dụ: ffmpeg sox espeak-ng
OPENCLAW_DOCKER_APT_PACKAGES=

# ── AI Providers ─────────────────────────────────────────────

# Anthropic Claude — nhà cung cấp AI chính (BẮT BUỘC)
# Lấy tại: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — dùng cho embeddings, TTS, fallback (tuỳ chọn)
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Messaging Channels ───────────────────────────────────────

# Telegram Bot (lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Zalo Official Account — Bot API
# Lấy tại: https://developers.zalo.me
ZALO_APP_ID=your_zalo_app_id
ZALO_SECRET_KEY=your_zalo_secret_key
ZALO_REFRESH_TOKEN=your_zalo_refresh_token

# Zalo Personal Account (ZaloUser extension) — tuỳ chọn
# Số điện thoại tài khoản Zalo cá nhân dùng làm bot
ZALO_BOT_PHONE=

# ── TTS (Text-to-Speech) ─────────────────────────────────────
# Edge TTS đã được cấu hình sẵn trong openclaw.config.vietnam.json
# và miễn phí — không cần API key.

# ElevenLabs — TTS chất lượng cao (tuỳ chọn)
# Lấy tại: https://elevenlabs.io
ELEVENLABS_API_KEY=xi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Memory & Search ──────────────────────────────────────────
# LanceDB vector memory dùng embedding của OpenAI (OPENAI_API_KEY ở trên)

# Brave Search — tìm kiếm web (tuỳ chọn)
# Lấy tại: https://api.search.brave.com
BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Browser Automation ───────────────────────────────────────
# Browserless.io — headless browser (tuỳ chọn)
BROWSERLESS_API_KEY=

# ── Eldercare / Home Assistant ───────────────────────────────
# Chỉ cần nếu dùng module BÀ NỘI CARE
# Xem thêm: .env.eldercare.example

# URL Home Assistant (e.g. http://192.168.1.100:8123)
HA_URL=
# Long-lived access token từ HA
HA_TOKEN=
# IP máy tính bảng (Fully Kiosk)
TABLET_IP=
TABLET_FULLY_KIOSK_PASSWORD=

# ── Claude Web Session (tuỳ chọn) ────────────────────────────
# Dùng khi xác thực qua web session thay vì API key
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# ── Logging ──────────────────────────────────────────────────
# Mức log: debug | info | warn | error
LOG_LEVEL=info

# ── Development ──────────────────────────────────────────────
# Bỏ qua khởi tạo channel (dùng khi test)
# OPENCLAW_SKIP_CHANNELS=1
